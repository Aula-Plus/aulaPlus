APP_NAME="Portal Docentes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- SPA / Sanctum ---
# Vite dev server origin. Also drives CORS allowed_origins (config/cors.php).
# In local dev, config/cors.php additionally accepts any localhost port (Vite
# may pick 5174, 5175, … if 5173 is taken). In production set this to the real
# frontend domain(s), comma-separated, and CORS becomes strict.
FRONTEND_URL=http://localhost:5173
# Domains that receive stateful (cookie) auth. `localhost:*` matches whatever
# port Vite ends up on. In production set the exact domain (no wildcard).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
# Defaults match the Sail "pgsql" service. In production these come from the
# managed provider (Railway/Render/Neon) — never hardcode real hosts here.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Shared cookie host for the SPA + API. In production set to your apex domain.
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Private file storage (S3-compatible, e.g. Cloudflare R2) ---
# Buckets MUST be private; files are served via temporary signed URLs only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Anthropic (backend only; used by the AI teaching-assistant Jobs) ---
# This key lives ONLY in the backend and is never exposed to the client or logged.
ANTHROPIC_API_KEY=
# No default is hardcoded anywhere in code on purpose. Set this to the current
# Sonnet model id — check Anthropic's documentation for the model in effect at
# deploy time (model ids change), e.g. a claude Sonnet identifier.
ANTHROPIC_MODEL=

# --- Error monitoring ---
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
